{
  "name": "redagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise RedAgent operational control-plane console and validation harness.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts && npm run build:cli",
    "build:cli": "tsc --project frontend/tsconfig.cli.json && npm run build:compat-126-study && npm run build:compat-124-study",
    "build:compat-124-study": "esbuild frontend/cli/compat_124-study.ts --bundle --platform=node --format=esm --outfile=frontend/cli-dist/compat-124-study.mjs",
    "build:compat-126-study": "esbuild frontend/cli/compat_126-study.ts --bundle --platform=node --format=esm --outfile=frontend/cli-dist/compat-126-study.mjs",
    "cli": "node frontend/cli-dist/cli/redagent.js",
    "evaluate:compat-126-study": "npm run build:compat-126-study && node frontend/cli-dist/compat-126-study.mjs",
    "evaluate:compat-124-study": "npm run build:compat-124-study && node frontend/cli-dist/compat-124-study.mjs",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "lint": "eslint \"frontend/**/*.{ts,tsx}\"",
    "test:unit": "vitest run --config frontend/vite.config.ts",
    "generate:openapi": "node scripts/run_openapi_export.mjs",
    "generate:api": "npm run generate:openapi && openapi-typescript frontend/openapi.json -o frontend/src/generated/api.d.ts",
    "check:api": "node scripts/check_generated_api.mjs",
    "check:ui-foundation-bundle": "npm run build && node scripts/check_ui_foundation_bundle.mjs",
    "check:shell-bundle": "npm run build && node scripts/check_compat_127_shell_bundle.mjs",
    "qualify:shell": "node scripts/run_compat_127_browser_qualification.mjs",
    "test": "playwright test",
    "test:all": "npm run check:api && npm run typecheck && npm run lint && npm run test:unit && npm run build && npm test"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.0",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "18.19.130",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.4",
    "esbuild": "0.25.12",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}

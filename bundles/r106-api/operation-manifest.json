    {"operation_id": "getAudit", "method": "GET", "path": "/admin/audit", "risk": "admin_read", "media_types": [], "state_change": false, "protected_properties": []},
    {"operation_id": "getDocument", "method": "GET", "path": "/documents/{documentId}", "risk": "read", "media_types": [], "state_change": false, "protected_properties": ["owner_id", "title"]},
    {"operation_id": "getProfile", "method": "GET", "path": "/profiles/{profileId}", "risk": "read", "media_types": [], "state_change": false, "protected_properties": ["internal_note"]},
    {"operation_id": "transferDocument", "method": "POST", "path": "/documents/{documentId}/transfer", "risk": "update_owned", "media_types": ["application/json"], "state_change": true, "cleanup": "transferDocumentToOriginalOwner"}
